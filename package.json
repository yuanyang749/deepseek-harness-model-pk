{
  "name": "@yuanyang749/dsh-model-pk",
  "version": "0.1.1",
  "description": "A local, fairness-frozen multi-model comparison harness for DSH.",
  "license": "MIT",
  "author": "yuanyang749",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuanyang749/deepseek-harness-model-pk.git"
  },
  "homepage": "https://github.com/yuanyang749/deepseek-harness-model-pk#readme",
  "bugs": {
    "url": "https://github.com/yuanyang749/deepseek-harness-model-pk/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "model-comparison",
    "llm-evaluation",
    "multi-model"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs/COMPATIBILITY_REPORT.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "pnpm build:host && pnpm build:client",
    "build:host": "tsc -p tsconfig.build.json",
    "build:client": "tsc -p tsconfig.client.json --emitDeclarationOnly && tsdown src/client/index.tsx --format cjs --platform browser --target es2022 --tsconfig tsconfig.client.json --external react --external react/jsx-runtime --external react-dom --external react-dom/client --out-dir .client-build --clean --sourcemap --logLevel warn --no-dts && node scripts/build-client.mjs",
    "build:native": "node scripts/build-native.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "compat": "node scripts/compatibility-report.mjs",
    "dsh:bootstrap": "node scripts/bootstrap-dsh.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@yuanyang749/model-pk-native-darwin-arm64": "workspace:*",
    "@yuanyang749/model-pk-native-darwin-x64": "workspace:*",
    "@yuanyang749/model-pk-native-win32-arm64": "workspace:*",
    "@yuanyang749/model-pk-native-win32-x64": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.1-rc.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.14.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.82.1"
  }
}
